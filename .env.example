# Variáveis de ambiente do projeto — TODAS OPCIONAIS.
# Uso: copie para .env (que é ignorado pelo git) e preencha os valores.
#   PowerShell: Copy-Item .env.example .env
#   Linux/macOS: cp .env.example .env
# O .env é carregado automaticamente pelas receitas do justfile.

# Token do Hugging Face: aumenta o limite de downloads. O modelo é público e
# funciona SEM token. Gerar em https://huggingface.co/settings/tokens (permissão "read").
HF_TOKEN=

# Silencia o aviso de symlinks do cache do Hugging Face no Windows (1 = silenciar)
HF_HUB_DISABLE_SYMLINKS_WARNING=
